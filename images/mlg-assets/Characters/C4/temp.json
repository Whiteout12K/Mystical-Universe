    "n027": {
      "name": "Agent - Scout",
      "type": "Sub-Roles",
      "description": "If stamina is above 80% before dashing, the character’s movement speed increases by +300% for a short duration to perform a quick flashstep. Activating a basic skill or special skill after the flashstep will increase the piercing of the damage dealt by +250%. If piercing stat is high enough to remove all defense, then additional piercing will give the opponent negative defense which will make incoming damage increased (by a similar calculation of damage reduction by defense but inversed).",
      "description_style": {"paddingTop": 7},
      "additional": [
        {"text": "Increase luck by +15. Additionally, defeating enemies while in combat has a 10% chance to drop <b class=\"tactical-insight\">[Tactical Insight]</b> nearby, a consumable that grants a buff to self and all allies.",
          "style": {"paddingTop": 7}},
        {"text": "Covert Recon: In non-combat, gain <b class=\"stealth\">[Stealth]</b>, which can be removed by quick movements or a first attack.",
          "style": {"paddingTop": 7}},
        {"text": "{{effect:tactical-insight}}",
          "style": {"paddingTop": 7}},
        {"text": "{{effect:stealth}}",
          "style": {"paddingTop": 7}}
      ],
      "status": "outlined",
      "id": "n027",
      "group": "",
      "prerequisite": "Agent",
      "icon": "",
      "before": ["n011"],
      "after": ["n073", "n074"],
      "branch": "n004",
      "position": {"x": 2278, "y": 3064}
    },

    "n028": {
      "name": "Agent - Hacker",
      "type": "Sub-Roles",
      "description": "Every third basic skill hit from this character will apply a stack <b class=\"pen-testing\">[Pen Testing]</b> on hit opponents. When an opponent reaches 5 stacks, all current stacks are consumed, and they are inflicted with <b class=\"system-infiltration\">[System Infiltration]</b>.",
      "description_style": {"paddingTop": 7},
      "additional": [
        {"text": "Every 10 seconds in combat, if there's an opponent nearby with <b class=\"pen-testing\">[Pen Testing]</b> stacks, this character generates a single stack of <b class=\"firewall\">[Firewall]</b> buff for self.",
