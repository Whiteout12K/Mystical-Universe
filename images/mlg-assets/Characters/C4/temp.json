    "n053": {
      "name": "Gostlynger",
      "type": "Species",
      "description": "(Later release) Gain an additional skill and passive.",
      "description_style": {"paddingTop": 7},
      "additional": [
        {"text": "Whenever an opponent is defeated, their soul will drop. Approaching it will collect it into the shadow storage. When using this skill, you can select a specific shadow and it will then form as a minion to fight for your side. Bosses cannot become shadows. Collected shadows persist in inventory (and can be freely removed) and can be resummoned in any location or gamemode so long as they do not die in battle. Using the skill again will unsummon the shadows.",
          "style": {"paddingTop": 7}},
        {"text": "Special Skill: Shadow Necromancy - Gain the Gostlynger ability to manipulate morality and convert defeated foes to build your army. The summoned minions will stay indefinitely whilst in battle (or 10 seconds idle) and inherit 40% of the character’s max health and 80% of all other stats; they may also receive buffs that “allies” can receive. The minion will maintain its characteristics as when it was alive. Up to 5 shadows may be summoned at once but the energy gauge cost scales per shadow.",
          "style": {"paddingTop": 7}},
        {"text": "Energy Gauge: 20%",
          "style": {"paddingTop": 7}}
      ],
      "status": "outlined",
      "id": "n053",
      "group": "Arch-Elemental Path",
      "prerequisite": "Mystical Path - Arch-Elemental",
      "icon": "",
      "before": ["n032"],
      "after": [],
      "branch": "n006",
      "position": {"x": 3373, "y": 1860}
    },

